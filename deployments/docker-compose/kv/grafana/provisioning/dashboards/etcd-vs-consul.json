{
  "title": "etcd vs Consul",
  "uid": "etcd-consul-bench",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "etcd — Leader present",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "NO LEADER", "color": "red" }, "1": { "text": "Leader OK", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [{ "expr": "etcd_server_has_leader", "legendFormat": "etcd", "datasource": { "type": "prometheus", "uid": "prometheus" } }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Consul — Raft has leader",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "NO LEADER", "color": "red" }, "1": { "text": "Leader OK", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [{ "expr": "consul_raft_leader", "legendFormat": "consul", "datasource": { "type": "prometheus", "uid": "prometheus" } }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Consul — up",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [{ "expr": "consul_up", "legendFormat": "consul", "datasource": { "type": "prometheus", "uid": "prometheus" } }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "etcd — Health failures total",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [{ "expr": "etcd_server_health_failures", "legendFormat": "failures", "datasource": { "type": "prometheus", "uid": "prometheus" } }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 10,
      "type": "row",
      "title": "etcd — Throughput & Proposals",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "etcd — Proposals committed / sec",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "color": { "mode": "palette-classic" } }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "rate(etcd_server_proposals_committed_total[1m])", "legendFormat": "committed/s", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "rate(etcd_server_proposals_applied_total[1m])", "legendFormat": "applied/s", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "rate(etcd_server_proposals_failed_total[1m])", "legendFormat": "failed/s", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "etcd — gRPC client traffic (bytes/s)",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "Bps", "color": { "mode": "palette-classic" } }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "rate(etcd_network_client_grpc_received_bytes_total[1m])", "legendFormat": "rx bytes/s", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "rate(etcd_network_client_grpc_sent_bytes_total[1m])", "legendFormat": "tx bytes/s", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 20,
      "type": "row",
      "title": "etcd — Disk Latency",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "etcd — WAL fsync latency (p50 / p99)",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "histogram_quantile(0.5,  rate(etcd_disk_wal_fsync_duration_seconds_bucket[1m]))", "legendFormat": "p50", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "histogram_quantile(0.99, rate(etcd_disk_wal_fsync_duration_seconds_bucket[1m]))", "legendFormat": "p99", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "etcd — Backend commit latency (p50 / p99)",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "histogram_quantile(0.5,  rate(etcd_disk_backend_commit_duration_seconds_bucket[1m]))", "legendFormat": "p50", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "histogram_quantile(0.99, rate(etcd_disk_backend_commit_duration_seconds_bucket[1m]))", "legendFormat": "p99", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 30,
      "type": "row",
      "title": "etcd — MVCC / Keys",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "etcd — Keys total",
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "etcd_debugging_mvcc_keys_total", "legendFormat": "keys", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "etcd — Events rate (put / delete / watch)",
      "gridPos": { "x": 12, "y": 23, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "color": { "mode": "palette-classic" } }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "rate(etcd_debugging_mvcc_put_total[1m])", "legendFormat": "put/s", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "rate(etcd_debugging_mvcc_delete_total[1m])", "legendFormat": "delete/s", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "rate(etcd_debugging_mvcc_range_total[1m])", "legendFormat": "range/s", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 40,
      "type": "row",
      "title": "Consul — Cluster health",
      "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Consul — Cluster members (LAN)",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "consul_serf_lan_members", "legendFormat": "members", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "consul_raft_peers", "legendFormat": "raft peers", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Consul — Registered services",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "consul_catalog_services", "legendFormat": "services", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    }
  ]
}
